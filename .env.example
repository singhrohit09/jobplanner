# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (Production / Vercel Deployment)
# Project: jobplanner-82fef
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="jobplanner-82fef.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="jobplanner-82fef"
VITE_FIREBASE_STORAGE_BUCKET="jobplanner-82fef.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="829279120489"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_DATABASE_ID="(default)"

# Compatibility variables (if using NEXT_PUBLIC prefix)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="jobplanner-82fef.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="jobplanner-82fef"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="jobplanner-82fef.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="829279120489"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
NEXT_PUBLIC_FIREBASE_DATABASE_ID="(default)"

# Supabase configuration (optional, defaults to persistent browser local storage when unset)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Live Job Search API (Adzuna Developer Portal: https://developer.adzuna.com/)
# Used by the backend server for live job postings and matching
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""


