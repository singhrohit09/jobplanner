rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify that the caller owns the user record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User document rules: users can only read, write, and update their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Any subcollections nested under the user's document
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public portfolios: publicly readable if published, editable only by author
    match /public_portfolios/{publicId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
